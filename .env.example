# Copy to .env for local-only use, or configure the same values as deployment secrets.
# Never commit a real API key.
OPENAI_API_KEY=replace-with-your-project-api-key
OPENAI_MODEL=gpt-5.6-luna

# Production runtime paths should point to persistent private mounts. These values are
# read from the process environment; do not place real credentials in this file.
# JOB_HUNT_RUNTIME_DIR=D:\private\job-hunt-runtime
# JOB_HUNT_OUTPUT_DIR=D:\private\job-hunt-output
# JOB_HUNT_GMAIL_RUN_DIR=D:\private\job-hunt-output\gmail-runs
# Optional validated local cache path; the app-owned Drive workbook remains authoritative.
# JOB_HUNT_REGISTRY_PATH=D:\private\source-cache\Company_Source_Registry.xlsx
# JOB_HUNT_PROJECT_ROOT=D:\deploy\job-hunt
# JOB_HUNT_GOOGLE_CREDENTIALS=D:\private\oauth-client.json
# JOB_HUNT_SESSION_SECRET=replace-with-a-long-random-deployment-secret

# Optional after uploading a baseline resume through the private React UI.
# JOB_HUNT_BASE_RESUME=D:\private\Asrith_Ladi_AI_ML_Engineer.docx
